# Incog backend (c2-backend) environment. Copy to .env and fill in — never commit the real .env.
# Source of truth for this list is BACKEND.md ("Environment variables"). Placeholders only here.

# ============================================
# DATABASE (required) — PostgreSQL with PostGIS
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/incog_db

# ============================================
# API SECURITY (required)
# ============================================
# Sent by the app as the X-Incog-Key header. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INCOG_API_KEY=your-incog-api-key
# (AGENT_SECRET_KEY is the deprecated old name — still accepted as a fallback, but use INCOG_API_KEY.)

# ============================================
# EVIDENCE ENCRYPTION (optional) — AES-256-GCM, pre-shared with the app
# ============================================
# Base64 of 32 random bytes; MUST be byte-for-byte identical to the app's incog.evidenceKeyBase64.
# Unset => evidence is refused with HTTP 503 (the SOS signal + alert are unaffected). Generate:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
EVIDENCE_AES_KEY=your-base64-aes-256-key

# ============================================
# ALERT DISPATCH — Twilio (SMS or WhatsApp)
# ============================================
ENABLE_SMS_DISPATCH=true
# "sms" (default) or "whatsapp". Twilio TRIAL accounts reject free-form SMS (error 572006), so the
# WhatsApp sandbox is used for demos — see BACKEND.md "SMS vs WhatsApp".
TWILIO_CHANNEL=sms
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sender. For the WhatsApp sandbox use Twilio's shared number +14155238886.
TWILIO_PHONE_NUMBER=+1234567890
# Normally EMPTY. A shared catch-all that receives EVERY user's alert (comma-separated, with country
# code). Per-user contacts now arrive in the SOS payload; leave this blank unless you want a global
# responder line. See BACKEND.md.
EMERGENCY_CONTACTS=

# ============================================
# ALERT DISPATCH — Webhook (optional; Discord/Slack)
# ============================================
ENABLE_WEBHOOK_DISPATCH=false
DISPATCH_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook

# ============================================
# RESPONDER MAP (optional) — dashboard fallback centre (defaults to BMSCE)
# ============================================
MAP_DEFAULT_LAT=12.9412
MAP_DEFAULT_LON=77.5652

# ============================================
# SIMULATOR (tracker.py only, dev)
# ============================================
C2_SERVER_URL=https://incog-c2-backend.onrender.com/api/v1/sos
DEVICE_ID=demo-device-01
SIM_START_LAT=12.9412
SIM_START_LON=77.5652
