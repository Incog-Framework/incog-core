# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/incog_db

# ============================================
# ENCRYPTION CONFIGURATION
# ============================================
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ============================================
# API SECURITY
# ============================================
AGENT_SECRET_KEY=your-super-secret-agent-key-min-16-chars

# ============================================
# SOS DISPATCHER - SMS NOTIFICATIONS (Twilio)
# ============================================
ENABLE_SMS_DISPATCH=true
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
EMERGENCY_CONTACTS=+1-555-0100,+1-555-0101,+1-555-0102

# ============================================
# SOS DISPATCHER - WEBHOOK NOTIFICATIONS
# ============================================
ENABLE_WEBHOOK_DISPATCH=false
DISPATCH_WEBHOOK_URL=https://your-server.com/api/emergency-alerts

# ============================================
# CLIENT CONFIGURATION
# ============================================
C2_SERVER_URL=https://incog-c2-backend.onrender.com/api/v1/sos
